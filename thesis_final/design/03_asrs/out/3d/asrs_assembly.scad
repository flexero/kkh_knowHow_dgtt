// DESIGN - to be checked and released by the responsible engineer. Coordinates: x along aisle, y across, z up.

bays = 19;
levels = 10;
bay = 1925;
L_rack = 36675;
H_rack = 12600;
W_rack = 4100;
clear_beam = 1825;
z1 = 450;
pitch = 1250;
up_w = 100;
up_d = 80;
gap = 75;
aisle = 1500;
x0 = 1200;
y_face = 750;
y_rear = 2050;
y_crate_c = 1400;
cL = 1200;
cW = 800;
cH = 600;
c_leg = 160;
beam_h = 120;
beam_b = 50;
mast_h = 600;
mast_b = 400;
mast_t = 6;
H_mast = 13100;
wheel_D = 400;
wheelbase = 2400;
stroke = 1350;
drum_D = 315;
conv_top = 700;
fork_len = 1300;
rail_top_z0 = 13130;
rail_top_z1 = 13250;
tie_z0 = 13250;
tie_z1 = 13350;
fork_w = [450, 400, 350];  fork_t = [60, 45, 35];
function lz(l) = z1 + (l - 1) * pitch;     // beam top of level l
function cx(b, k) = x0 + b * bay + up_w + gap + cW / 2 + k * (cW + gap);
module box(a, b) { translate(a) cube([b[0]-a[0], b[1]-a[1], b[2]-a[2]]); }
module brace(a, b, w=40) { hull() { translate(a - [w/2, w/2, w/2]) cube(w); translate(b - [w/2, w/2, w/2]) cube(w); } }

use <rack.scad>
use <crate.scad>
use <crane.scad>
use <io.scad>
rack();
translate([0, 0, 0]) box([-2500, -25, 0], [x0 + L_rack + 2000, 25, 30]);   // bottom rail
translate([x0, -10, rail_top_z0]) cube([L_rack, 20, rail_top_z1 - rail_top_z0]);   // top guide rail
translate([cx(3, 0) + 100, 0, 0]) crane(4, stroke, 1);
for (b = [0 : bays - 1], k = [0, 1], l = [1 : levels], s = [-1, 1]) if ((b*7 + l*3 + k*5 + (s+1)*11) % 10 < 7)
  translate([cx(b, k), s * y_crate_c, lz(l)]) crate();
conveyor(-1); conveyor(1);
