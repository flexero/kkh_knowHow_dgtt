module box(a, b) { translate(a) cube([b[0]-a[0], b[1]-a[1], b[2]-a[2]]); }
module brace(a, b, w=40) { hull() { translate(a - [w/2, w/2, w/2]) cube(w); translate(b - [w/2, w/2, w/2]) cube(w); } }

