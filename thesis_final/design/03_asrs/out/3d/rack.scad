// Rack (both sides) - generated by asrs_3d.py from out/design_result.json (F3) - units mm
// DESIGN - to be checked and released by the responsible engineer. Coordinates: x along aisle, y across, z up.

bays = 19;
levels = 10;
bay = 1925;
L_rack = 36675;
H_rack = 12600;
W_rack = 4100;
clear_beam = 1825;
z1 = 450;
pitch = 1250;
up_w = 100;
up_d = 80;
gap = 75;
aisle = 1500;
x0 = 1200;
y_face = 750;
y_rear = 2050;
y_crate_c = 1400;
cL = 1200;
cW = 800;
cH = 600;
c_leg = 160;
beam_h = 120;
beam_b = 50;
mast_h = 600;
mast_b = 400;
mast_t = 6;
H_mast = 13100;
wheel_D = 400;
wheelbase = 2400;
stroke = 1350;
drum_D = 315;
conv_top = 700;
fork_len = 1300;
rail_top_z0 = 13130;
rail_top_z1 = 13250;
tie_z0 = 13250;
tie_z1 = 13350;
fork_w = [450, 400, 350];  fork_t = [60, 45, 35];
function lz(l) = z1 + (l - 1) * pitch;     // beam top of level l
function cx(b, k) = x0 + b * bay + up_w + gap + cW / 2 + k * (cW + gap);
module box(a, b) { translate(a) cube([b[0]-a[0], b[1]-a[1], b[2]-a[2]]); }
module brace(a, b, w=40) { hull() { translate(a - [w/2, w/2, w/2]) cube(w); translate(b - [w/2, w/2, w/2]) cube(w); } }

module rack_side() {
  yf1 = y_face + up_d; yr0 = y_rear - up_d;
  for (i = [0 : bays]) {
    x = x0 + i * bay;
    for (yy = [[y_face, yf1], [yr0, y_rear]]) { box([x-25, yy[0]-35, 0], [x+up_w+25, yy[1]+35, 10]);
                                        box([x, yy[0], 10], [x+up_w, yy[1], H_rack]); }
    for (k = [0 : floor((H_rack - 250) / 1250) - 1]) {
      z = 150 + k * 1250; xc = x + up_w / 2;
      brace([xc, yf1, z], [xc, yr0, z]);
      if (k % 2 == 0) brace([xc, yf1, z], [xc, yr0, z + 1250]); else brace([xc, yr0, z], [xc, yf1, z + 1250]);
    }
  }
  for (b = [0 : bays - 1], l = [1 : levels]) {
    xa = x0 + b * bay + up_w; zt = lz(l);
    box([xa, yf1 - beam_b, zt - beam_h], [xa + clear_beam, yf1, zt]);
    box([xa, yr0, zt - beam_h], [xa + clear_beam, yr0 + beam_b, zt]);
    for (k = [0, 1], sx = [-1, 1]) { xr = cx(b, k) + sx * (cW / 2 - 75);
      box([xr - 20, yf1 - beam_b, zt - 30], [xr + 20, yr0 + beam_b, zt]); }
  }
  for (yy = [[y_face, y_face + up_d], [y_rear - up_d, y_rear]]) box([x0, yy[0], H_rack - 120], [x0 + L_rack, yy[1], H_rack]);
}
module rack() { rack_side(); mirror([0, 1, 0]) rack_side(); }
rack();
